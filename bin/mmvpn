#!/bin/bash
# mmvpn — turn Mac mini VPN on or off from a terminal. The menu-bar app runs the same commands.
#
#   mmvpn up      start the tunnel, wait until it answers from Japan, then turn on site routing
#   mmvpn down    turn off site routing and stop the tunnel
#   mmvpn status  what is on, and where the exit is
#
# WHAT CHANGES ON YOUR MAC
# One setting: the automatic proxy configuration URL, on every network service, so Wi-Fi, Ethernet
# and tethering behave the same. It points at the PAC file served on 127.0.0.1, which sends only the
# listed sites to the tunnel. Everything else, including every other app, goes direct as before.
# `down` clears it. The routing table is never touched.
#
# FAIL-CLOSED: `up` turns routing on only once the exit answers from Japan. With routing on and no
# exit, the listed sites break while everything else works, which looks like "the VPN broke the
# internet".
set -uo pipefail
CONF_DIR="${MMVPN_CONFIG_DIR:-$HOME/.config/macmini-vpn}"
# shellcheck source=/dev/null
[ -f "$CONF_DIR/config" ] && . "$CONF_DIR/config"
ID="${MMVPN_ID:-com.macminivpn}"
PORT="${SOCKS_PORT:-1082}"
PAC="http://127.0.0.1:${PAC_PORT:-1081}/jp.pac"
LABEL="$ID.tunnel"
PLIST="${MMVPN_AGENTS_DIR:-$HOME/Library/LaunchAgents}/$LABEL.plist"
# Seams so the tests never touch the real proxy setting, the real agents or the network.
NETWORKSETUP="${NETWORKSETUP_BIN:-networksetup}"
LAUNCHCTL="${LAUNCHCTL_BIN:-launchctl}"
CURL="${CURL_BIN:-curl}"
WAIT="${MMVPN_WAIT:-40}"

pac() {  # pac on|off — every network service
  "$NETWORKSETUP" -listallnetworkservices 2>/dev/null | tail -n +2 | sed 's/^\*//' | while read -r svc; do
    [ -z "$svc" ] && continue
    if [ "$1" = on ]; then
      "$NETWORKSETUP" -setautoproxyurl "$svc" "$PAC" >/dev/null 2>&1
    else
      "$NETWORKSETUP" -setautoproxystate "$svc" off >/dev/null 2>&1
    fi
  done
}

exit_country() {  # the country the exit reports, or empty when the tunnel does not answer
  "$CURL" -s -m 15 -x "socks5h://127.0.0.1:$PORT" 'http://ip-api.com/json/?fields=country' 2>/dev/null \
    | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin).get("country",""))' 2>/dev/null
}

routing_on() {
  scutil --proxy 2>/dev/null | grep -q "ProxyAutoConfigURLString : $PAC" &&
    scutil --proxy 2>/dev/null | grep -q 'ProxyAutoConfigEnable : 1'
}

status() {
  local c; c="$(exit_country)"
  printf '  exit          : %s\n' "${c:-no answer}"
  if routing_on; then
    printf '  site routing  : on (only the sites in jp.pac go through Japan)\n'
  else
    printf '  site routing  : off (everything goes direct)\n'
  fi
}

case "${1:-status}" in
  up)
    "$LAUNCHCTL" bootstrap "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 \
      || "$LAUNCHCTL" kickstart "gui/$(id -u)/$LABEL" >/dev/null 2>&1
    c=""
    for _ in $(seq 1 "$WAIT"); do
      c="$(exit_country)"; [ "$c" = Japan ] && break; sleep 1
    done
    if [ "$c" = Japan ]; then
      pac on; status
    else
      pac off
      echo "The Mac at home is not answering (${c:-no answer}). Site routing stays off."
      exit 1
    fi
    ;;
  down)
    pac off
    "$LAUNCHCTL" bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1
    status
    ;;
  status) status ;;
  *) echo "usage: mmvpn up|down|status"; exit 2 ;;
esac
